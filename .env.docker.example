APP_ENV_FILE=.env.docker
APP_NAME=Territorio
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://territorio.example.com
APP_PORT=8080
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

LOG_CHANNEL=stack
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=territorio
DB_USERNAME=territorio
DB_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

FILESYSTEM_DISK=local
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notificaciones@territorio.example.com
MAIL_FROM_NAME=Territorio

BACKUP_ENCRYPTION_PASSWORD=REPLACE_WITH_A_DIFFERENT_STRONG_PASSWORD
BACKUP_DRIVE_PATH=territorio-backups
RCLONE_CONFIG_PATH=./docker/backup/rclone.conf
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

METABASE_DB_DATABASE=metabase
METABASE_PORT=3000

TESTIAPP_BASE_URL=
TESTIAPP_API_TOKEN=
GOOGLE_CALENDAR_POLL_MINUTES=2
GOOGLE_CALENDAR_PAST_DAYS=30
GOOGLE_CALENDAR_FUTURE_MONTHS=18
